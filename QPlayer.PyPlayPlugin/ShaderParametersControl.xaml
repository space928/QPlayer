<UserControl x:Class="QPlayer.PyPlayPlugin.ShaderParametersControl" x:Name="ShaderParametersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QPlayer.PyPlayPlugin"
             xmlns:v="clr-namespace:QPlayer.Views;assembly=QPlayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance Type=local:ShaderParamsCueViewModel}">
    <StackPanel Margin="2">
        <TextBlock Text="Shader Parameters" FontStyle="Italic" Margin="4"/>
        <Border Background="{DynamicResource AREghZyBrush.Primary.2.Background.Static}" 
                BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Name"/>
                    <Label Grid.Column="1" Content="Value"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ShaderParameters}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <ItemContainerTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <v:TextField Text="{Binding Name}"/>
                                <v:TextField Grid.Column="1" ShowSpinner="True" SpinnerType="Double" SpinRate="0.01" Text="{Binding Value}"/>
                                <Button Grid.Column="2" DockPanel.Dock="Right" Content="X" Command="{Binding DataContext.DeleteShaderParameterCommand, ElementName=ShaderParametersControl}" CommandParameter="{Binding}"/>
                            </Grid>
                        </ItemContainerTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add Shader Parameter" Command="{Binding AddShaderParameterCommand}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
