<UserControl x:Class="QPlayer.Views.Vec2Field"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QPlayer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Vec2FieldUserControl">
    <Grid DataContext="{Binding ElementName=Vec2FieldUserControl}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <local:TextField x:Name="XField" Grid.Column="0" ShowSpinner="{Binding ShowSpinner}" SpinnerType="Double" SpinRate="{Binding SpinRate}" ClampValue="{Binding ClampValue}" MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}" Text="{Binding X, UpdateSourceTrigger=Default}" Margin="0,0,2,0"/>
        <local:TextField x:Name="YField" Grid.Column="1" ShowSpinner="{Binding ShowSpinner}" SpinnerType="Double" SpinRate="{Binding SpinRate}" ClampValue="{Binding ClampValue}" MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}" Text="{Binding Y, UpdateSourceTrigger=Default}" Margin="2,0,0,0"/>
    </Grid>
</UserControl>
