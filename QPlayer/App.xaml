<Application x:Class="QPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QPlayer"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="CascadiaMono">pack://application:,,,/Resources/#Cascadia Mono</FontFamily>
            <!--<FontFamily x:Key="Inter">pack://application:,,,/Resources/#Inter</FontFamily>-->

        </ResourceDictionary>
    </Application.Resources>
</Application>
